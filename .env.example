# ==============================================================================
# 🗄️ DATABASE CONFIGURATION (PostgreSQL / Neon)
# ==============================================================================
# Connection string utama untuk database (Gunakan pooled connection jika ada)
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Opsional: Gunakan baris di bawah ini jika menggunakan Prisma < 5.10 
# atau butuh koneksi langsung (unpooled) untuk migrasi
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require"


# ==============================================================================
# 🔐 AUTHENTICATION (NextAuth.js / Auth.js)
# ==============================================================================
# Generate secret key dengan perintah terminal: openssl rand -base64 32
AUTH_SECRET="PBZXCoIcAeJdOXxDxxxxx=" 
AUTH_URL="http://localhost:3000"

# --- Google OAuth Provider ---
# Dapatkan dari: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="48309389xxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSxxxxxxxxxxxxxxxxxxx"


# ==============================================================================
# 🤖 ARTIFICIAL INTELLIGENCE (Google Gemini)
# ==============================================================================
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AQ.Ab8RNxxxxxxxxxxxxxxxxxx"


# ==============================================================================
# ⚙️ BACKGROUND JOBS & QUEUE (Upstash QStash)
# ==============================================================================
# Dapatkan dari: https://console.upstash.com/qstash
QSTASH_URL="https://qstash.upstash.io/v2/messages"
QSTASH_TOKEN="19ebXxxxxxxxxxxxxxxx"
# Opsional tapi disarankan untuk keamanan (verifikasi webhook):
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxxxxxxxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxxxxxxxxxx"


# ==============================================================================
# 📱 MESSAGING & BOTS
# ==============================================================================
# --- Telegram Bot ---
# Dapatkan dari Telegram App dengan chat @BotFather
telegram_BOT_TOKEN="894xxxxxxxxxx:AAHxxxxxxxxxxxxxxxxxxxx"
# Opsional: ID grup atau user default untuk notifikasi admin
# telegram_ADMIN_CHAT_ID="-100xxxxxxxxxx"

# --- WhatsApp Cloud API (Meta) ---
# Dapatkan dari: https://developers.facebook.com/apps/
whatsapp_TOKEN="EAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
whatsapp_PHONE_NUMBER_ID="123456789012345"
# Opsional: Business Account ID jika diperlukan untuk API tertentu
# whatsapp_BUSINESS_ACCOUNT_ID="123456789012345"
# Token rahasia yang kamu buat sendiri untuk verifikasi Webhook di Meta
whatsapp_VERIFY_TOKEN="zendompi_webhook_secret"

# ==============================================================================
# 📧 EMAIL SERVICE (SMTP / Resend) -> Opsional untuk Kirim Email
# ==============================================================================
# Jika menggunakan Resend (Sangat disarankan untuk Next.js) - https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"

# Jika menggunakan SMTP Tradisional (Gmail / Hostinger / dll)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="emailkamu@gmail.com"
SMTP_PASSWORD="password_aplikasi_atau_smtp"
SMTP_FROM="Admin <noreply@namadomainkamu.com>"


# ==============================================================================
# 📂 CLOUD STORAGE (AWS S3 / Cloudflare R2 / UploadThing) -> Opsional
# ==============================================================================
# Jika menggunakan UploadThing (Populer di ekosistem Next.js)
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxx"

# Jika menggunakan AWS S3 atau Cloudflare R2
# AWS_REGION="ap-southeast-1"
# AWS_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxx"
# AWS_BUCKET_NAME="nama-bucket-kamu"


# ==============================================================================
# 💳 PAYMENT GATEWAY (Midtrans - Khusus Indonesia) -> Opsional
# ==============================================================================
# Dapatkan dari: https://dashboard.midtrans.com/
# NEXT_PUBLIC prefix agar bisa diakses dari sisi Client (Browser)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
# Ubah ke true jika sudah naik ke production
MIDTRANS_IS_PRODUCTION=false


# ==============================================================================
# 📊 ANALYTICS & ERROR TRACKING (Opsional)
# ==============================================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Sentry (Untuk melacak error di server & client)
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxx"