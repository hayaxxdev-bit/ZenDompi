# ==========================================
# 1. APP & ENVIRONMENT
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Buat string acak 32 karakter (bisa pakai `openssl rand -base64 32`)
AUTH_SECRET="your_jwt_secret_key_minimum_32_characters_long"

# ==========================================
# 2. NEON DATABASE (POSTGRESQL + PRISMA)
# ==========================================
# Connection Pooling URL (Gunakan ini untuk Serverless/Apps agar tidak kehabisan koneksi)
# Format: postgresql://user:password@ep-xyz.region.aws.neon.tech/zendompi_db?sslmode=require
DATABASE_URL="postgresql://hayaxxdev-bit:YOUR_NEON_PASSWORD@ep-cool-host.us-east-1.aws.neon.tech/zendompi_db?sslmode=require"

# Direct URL (Wajib untuk Prisma Migrate / Push di Neon)
DIRECT_URL="postgresql://hayaxxdev-bit:YOUR_NEON_PASSWORD@ep-cool-host.us-east-1.aws.neon.tech/zendompi_db?sslmode=require"

# ==========================================
# 3. AI ENGINES (NLP & EXTRACTION)
# ==========================================
# Google Gemini API Key (Utama untuk ekstraksi pesan cepat)
GEMINI_API_KEY="AIzaSy..."

# OpenAI API Key (Opsional / Fallback)
OPENAI_API_KEY="sk-proj-..."

# DeepSeek API Key (Opsional / Analisis tingkat lanjut)
DEEPSEEK_API_KEY="sk-..."

# ==========================================
# 4. WHATSAPP CLOUD API (META)
# ==========================================
# Dapatkan dari Facebook Developers Portal
WA_PHONE_NUMBER_ID="123456789012345"
WA_ACCESS_TOKEN="EAAG..."
# Token rahasia buatanmu sendiri untuk verifikasi webhook saat pertama kali diautentikasi oleh Meta
WA_VERIFY_TOKEN="zendompi_wa_secret_verify_token_123"

# ==========================================
# 5. TELEGRAM BOT API
# ==========================================
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ"
# Token rahasia acak untuk memastikan webhook Telegram benar-benar berasal dari Telegram
TELEGRAM_WEBHOOK_SECRET="zendompi_telegram_secret_token_456"

# ==========================================
# 6. UPSTASH QSTASH (ASYNC QUEUE FOR VERCEL)
# ==========================================
# Mencegah timeout 10 detik Vercel saat AI sedang memproses pesan
QSTASH_URL="https://qstash.upstash.io/v2/publish"
QSTASH_TOKEN="ey..."
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."