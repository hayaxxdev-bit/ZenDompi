{
  "name": "@zendompi/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "clean": "rm -rf dist",
    "build": "pnpm db:generate && tsc"
  },
  "keywords": [],
  "author": "hayaxxdev-bit",
  "license": "ISC",
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.4",
    "@zendompi/typescript-config": "workspace:*",
    "prisma": "^7.9.1",
    "tsx": "^4.23.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  }
}